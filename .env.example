# Supabase — get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Opcional: segredo exclusivo para anonimizar os identificadores de tráfego.
# Se vazio, o sistema usa NEXTAUTH_SECRET.
ANALYTICS_HASH_SALT=
# Cupom que libera a retirada gratuita para familiares.
FAMILY_PICKUP_COUPON_CODE=RETIRADAHELENA
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Melhor Envio — token de produção e identificação obrigatória da aplicação
MELHOR_ENVIO_ACCESS_TOKEN=
MELHOR_ENVIO_API_URL=https://melhorenvio.com.br
MELHOR_ENVIO_USER_AGENT="Hellou Studio (studiohellou@gmail.com.br)"

# Mercado Pago
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-...
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_WEBHOOK_SECRET=

# Mercado Livre OAuth
MERCADO_LIVRE_APP_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=https://helloustudio.com.br/api/admin/mercado-livre/callback
# Use a long random secret. If omitted, NEXTAUTH_SECRET is used as a fallback.
MERCADO_LIVRE_TOKEN_ENCRYPTION_KEY=

# E-mails
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Hellou Studio <contato@helloustudio.com.br>"
RESEND_WEBHOOK_SECRET=whsec_...

# Sentry (monitoramento de erros e source maps)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
ADMIN_EMAIL=studiohellou@gmail.com

# Protege as rotas executadas pelo Vercel Cron
CRON_SECRET=

# Gemini (somente servidor). Usado no cadastro assistido, SEO, chat e resumos.
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_MODEL=gemini-3.6-flash
GOOGLE_GENAI_IMAGE_MODEL=gemini-3.1-flash-image

# OpenAI — assistente de catálogo na calculadora administrativa
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-2
